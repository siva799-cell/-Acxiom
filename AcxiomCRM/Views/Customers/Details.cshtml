@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = Model.CustomerName;
}
<div class="page-heading"><div><p class="eyebrow">CUSTOMER / @Model.CustomerCode</p><h1>@Model.CustomerName</h1><p class="text-secondary">@Model.CompanyName</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
@if (TempData["Success"] is string message) { <div class="alert alert-success">@message</div> }
<div class="data-panel"><dl class="row mb-0"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Location</dt><dd class="col-sm-9">@string.Join(", ", new[] { Model.City, Model.State }.Where(x => !string.IsNullOrWhiteSpace(x)))</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedDate.ToLocalTime().ToString("f")</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl></div>
@if (User.IsInRole("Admin") && Model.Status == "Active") { <form asp-action="Deactivate" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Deactivate this customer?')"><button class="btn btn-outline-danger" type="submit">Deactivate customer</button></form> }

@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Edit customer";
}
<div class="page-heading"><div><p class="eyebrow">CUSTOMERS / @Model.CustomerCode</p><h1>Edit customer</h1></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="data-panel form-panel">
    <input asp-for="CustomerCode" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2 mt-4"><button class="btn btn-primary" type="submit">Save changes</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

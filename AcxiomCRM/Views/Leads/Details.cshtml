@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = Model.LeadName;
}
<div class="page-heading"><div><p class="eyebrow">LEAD / @Model.LeadCode</p><h1>@Model.LeadName</h1><p class="text-secondary">@Model.CompanyName</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="data-panel"><dl class="row mb-0"><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Source</dt><dd class="col-sm-9">@Model.Source</dd><dt class="col-sm-3">Expected value</dt><dd class="col-sm-9">@Model.ExpectedValue.ToString("N2")</dd><dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Priority</dt><dd class="col-sm-9">@Model.Priority</dd></dl></div>
@if (Model.Status == "Qualified") { <form asp-action="Convert" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Convert this lead into a customer and opportunity?')"><button class="btn btn-primary">Convert lead</button></form> }
@if (User.IsInRole("Admin") && Model.Status is not ("Converted" or "Lost" or "Unqualified")) { <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Close this lead as lost? The record and its history will be retained.')"><button class="btn btn-outline-danger">Close lead</button></form> }

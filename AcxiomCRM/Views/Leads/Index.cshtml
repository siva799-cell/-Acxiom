@model AcxiomCRM.Services.PagedResult<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Leads";
}
<div class="page-heading"><div><p class="eyebrow">PIPELINE</p><h1>Leads</h1><p class="text-secondary mb-0">Track prospects through qualification and conversion.</p></div><a class="btn btn-primary" asp-action="Create">Add lead</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name, company, email or source" aria-label="Search leads" /></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option>@foreach (var value in new[] { "New", "Contacted", "Qualified", "Unqualified", "Converted", "Lost" }) { <option selected="@(ViewBag.Status == value)">@value</option> }</select></div><div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div></form>
<div class="table-responsive data-panel p-0"><table class="table table-hover align-middle mb-0"><thead><tr><th>Lead</th><th>Company</th><th>Source</th><th>Value</th><th>Status</th><th>Priority</th><th></th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-secondary py-5">No leads match this search.</td></tr> }
@foreach (var lead in Model.Items) { <tr><td><a asp-action="Details" asp-route-id="@lead.Id">@lead.LeadName</a><small class="d-block text-secondary">@lead.LeadCode</small></td><td>@lead.CompanyName</td><td>@lead.Source</td><td>@lead.ExpectedValue.ToString("N2")</td><td><span class="badge text-bg-light">@lead.Status</span></td><td>@lead.Priority</td><td><a asp-action="Edit" asp-route-id="@lead.Id">Edit</a></td></tr> }
</tbody></table></div>
@if (Model.PageCount > 1) { <nav class="mt-3" aria-label="Lead pages"><ul class="pagination pagination-sm">@for (var index = 1; index <= Model.PageCount; index++) { <li class="page-item @(Model.Page == index ? "active" : "")"><a class="page-link" asp-route-page="@index" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">@index</a></li> }</ul></nav> }

@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Edit lead";
    ViewData["IsEdit"] = true;
}
<div class="page-heading"><div><p class="eyebrow">LEADS / @Model.LeadCode</p><h1>Edit lead</h1></div></div>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="data-panel form-panel"><input asp-for="LeadCode" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><partial name="_Form" model="Model" /><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Save changes</button><a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

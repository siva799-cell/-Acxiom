@model AcxiomCRM.Services.PagedResult<AcxiomCRM.Models.CrmActivity>
@{
    ViewData["Title"] = "Activities";
}
<div class="page-heading"><div><p class="eyebrow">HISTORY</p><h1>Activities</h1><p class="text-secondary mb-0">Calls, meetings, emails, and tasks.</p></div><a class="btn btn-primary" asp-action="Create">Log activity</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<form method="get" class="row g-2 mb-3"><div class="col-md-3"><select name="type" class="form-select"><option value="">All types</option>@foreach (var item in new[] { "Call", "Meeting", "Email", "Task" }) { <option selected="@(ViewBag.Type == item)">@item</option> }</select></div><div class="col-md-3"><select name="status" class="form-select"><option value="">All statuses</option><option>Open</option><option>Completed</option></select></div><div class="col-auto"><button class="btn btn-outline-secondary">Filter</button></div></form>
<div class="table-responsive data-panel p-0"><table class="table table-hover align-middle mb-0"><thead><tr><th>Date</th><th>Activity</th><th>Type</th><th>Related record</th><th>Status</th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="5" class="text-center text-secondary py-5">No activities found.</td></tr> }
@foreach (var item in Model.Items) { <tr><td>@item.ActivityDate.ToLocalTime().ToString("g")</td><td>@item.Subject<small class="d-block text-secondary">@item.Description</small></td><td>@item.ActivityType</td><td>@(item.CustomerId is not null ? $"Customer #{item.CustomerId}" : item.LeadId is not null ? $"Lead #{item.LeadId}" : item.OpportunityId is not null ? $"Opportunity #{item.OpportunityId}" : "General")</td><td>@item.Status</td></tr> }
</tbody></table></div>

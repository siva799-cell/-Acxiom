@model AcxiomCRM.Models.CrmActivity
@{
    ViewData["Title"] = "Log activity";
}
<div class="page-heading"><div><p class="eyebrow">ACTIVITIES</p><h1>Log activity</h1></div></div>
<form asp-action="Create" method="post" class="data-panel form-panel"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3">
    <div class="col-md-6"><label asp-for="Subject" class="form-label"></label><input asp-for="Subject" class="form-control" /><span asp-validation-for="Subject" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="ActivityType" class="form-label"></label><select asp-for="ActivityType" class="form-select"><option>Call</option><option>Meeting</option><option>Email</option><option>Task</option></select></div>
    <div class="col-md-3"><label asp-for="ActivityDate" class="form-label"></label><input asp-for="ActivityDate" type="datetime-local" class="form-control" /></div>
    <div class="col-md-4"><label asp-for="CustomerId" class="form-label"></label><input asp-for="CustomerId" type="number" class="form-control" min="1" /></div>
    <div class="col-md-4"><label asp-for="LeadId" class="form-label"></label><input asp-for="LeadId" type="number" class="form-control" min="1" /></div>
    <div class="col-md-4"><label asp-for="OpportunityId" class="form-label"></label><input asp-for="OpportunityId" type="number" class="form-control" min="1" /></div>
    <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
</div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Save activity</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

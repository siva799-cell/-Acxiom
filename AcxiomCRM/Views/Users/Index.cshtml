@model AcxiomCRM.Services.PagedResult<AcxiomCRM.ViewModels.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "Users";
}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Users</h1><p class="text-secondary mb-0">Manage account access and assigned roles.</p></div><a class="btn btn-primary" asp-action="Create">Create user</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search name or email" aria-label="Search users" /></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form>
<div class="table-responsive data-panel p-0"><table class="table table-hover align-middle mb-0"><thead><tr><th>User</th><th>Role</th><th>Manager</th><th>Access</th><th>Lockout</th><th>Failed attempts</th><th></th></tr></thead><tbody>
@if (Model.Items.Count == 0) { <tr><td colspan="7" class="text-center text-secondary py-5">No users found.</td></tr> }
@foreach (var user in Model.Items) { <tr><td>@user.Name<small class="d-block text-secondary">@user.Email</small></td><td>@user.Role</td><td>@user.ManagerName</td><td><span class="badge text-bg-@(user.IsActive ? "success" : "secondary")">@(user.IsActive ? "Active" : "Inactive")</span></td><td>@(user.LockoutEnd > DateTimeOffset.UtcNow ? user.LockoutEnd?.ToLocalTime().ToString("g") : "Not locked")</td><td>@user.FailedAccessCount</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@user.Id">Edit</a> @if (user.LockoutEnd > DateTimeOffset.UtcNow || user.FailedAccessCount > 0) { <form asp-action="Unlock" asp-route-id="@user.Id" method="post" class="d-inline"><button class="btn btn-sm btn-link">Unlock</button></form> }</td></tr> }
</tbody></table></div>

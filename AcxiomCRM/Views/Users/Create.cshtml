@model AcxiomCRM.ViewModels.Users.UserFormViewModel
@{
    ViewData["Title"] = "Create user";
}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION / USERS</p><h1>Create user</h1></div></div>
<form asp-action="Create" method="post" class="data-panel form-panel"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><partial name="_Form" model="Model" /><div class="mt-3"><label asp-for="Password" class="form-label">Temporary password</label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span><small class="form-text">Must meet the configured Identity password policy.</small></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Create user</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

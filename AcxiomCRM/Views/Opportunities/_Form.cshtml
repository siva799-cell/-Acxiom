@model AcxiomCRM.Models.Opportunity
<div class="row g-3">
    <div class="col-md-6"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control" /><span asp-validation-for="OpportunityName" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control" min="0.01" step="0.01" /><span asp-validation-for="Amount" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control" min="0" max="100" /><span asp-validation-for="Probability" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select><span asp-validation-for="Stage" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control" /><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="CustomerId" class="form-label"></label><input asp-for="CustomerId" class="form-control" type="number" min="1" placeholder="Optional record ID" /><span asp-validation-for="CustomerId" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="LeadId" class="form-label"></label><input asp-for="LeadId" class="form-control" type="number" min="1" placeholder="Optional record ID" /><span asp-validation-for="LeadId" class="text-danger"></span></div>
    @if (ViewData["CanAssign"] as bool? == true) { <div class="col-md-6"><label asp-for="AssignedToId" class="form-label">Assigned to</label><select asp-for="AssignedToId" class="form-select"><option value="">Assign to me</option>@foreach (var assignee in (IEnumerable<AcxiomCRM.Models.ApplicationUser>)ViewBag.Assignees) { <option value="@assignee.Id">@assignee.Name (@assignee.Email)</option> }</select></div> }
    <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
</div>

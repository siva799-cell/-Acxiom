@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = Model.OpportunityName;
}
<div class="page-heading"><div><p class="eyebrow">OPPORTUNITY / @Model.Stage</p><h1>@Model.OpportunityName</h1></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a><a class="btn btn-outline-secondary" asp-action="Index">Back</a></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div class="data-panel"><dl class="row mb-0"><dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount.ToString("N2")</dd><dt class="col-sm-3">Probability</dt><dd class="col-sm-9">@Model.Probability%</dd><dt class="col-sm-3">Weighted pipeline</dt><dd class="col-sm-9">@Model.WeightedAmount.ToString("N2")</dd><dt class="col-sm-3">Stage</dt><dd class="col-sm-9">@Model.Stage</dd><dt class="col-sm-3">Expected close</dt><dd class="col-sm-9">@Model.ExpectedCloseDate?.ToLocalTime().ToString("d")</dd><dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd></dl></div>
@if (User.IsInRole("Admin") && Model.Status == "Open") { <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3" onsubmit="return confirm('Close this opportunity as lost? The record and its history will be retained.')"><button class="btn btn-outline-danger">Close opportunity</button></form> }

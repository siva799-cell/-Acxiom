@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Add opportunity";
}
<div class="page-heading"><div><p class="eyebrow">OPPORTUNITIES</p><h1>Add opportunity</h1></div></div>
<form asp-action="Create" method="post" class="data-panel form-panel"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><partial name="_Form" model="Model" /><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Create opportunity</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }

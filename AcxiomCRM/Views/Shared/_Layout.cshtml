<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">A</span><span>AcxiomCRM</span></a>
        <button class="btn btn-sm btn-outline-secondary d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-expanded="false">Menu</button>
        <div class="topbar-user">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="d-none d-sm-inline">@User.Identity.Name</span>
                <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="ChangePassword">Password</a>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary" type="submit">Sign out</button></form>
            }
            else
            {
                <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Login">Sign in</a>
            }
        </div>
    </header>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div id="mobileNav" class="collapse d-lg-none mobile-nav">
            <partial name="_AppNavigation" />
        </div>
        <div class="app-shell">
            <aside class="sidebar d-none d-lg-block"><partial name="_AppNavigation" /></aside>
            <main class="page-content" role="main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <main class="page-content unauthenticated" role="main">@RenderBody()</main>
    }
    <footer class="site-footer">AcxiomCRM <span>Customer relationship management</span></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
